# ═══════════════════════════════════════════════════════════════════
# عقار Match — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا تُدرج .env الحقيقي في Git أبداً.
# ═══════════════════════════════════════════════════════════════════

# ─── قاعدة البيانات (PostgreSQL) ───
# محلياً: docker compose up -d db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aqar_match?schema=public"

# ─── عنوان التطبيق العام ───
# ★ إلزامي في الإنتاج: يقود Canonical/Hreflang/OG/Sitemap/robots
#   المطلقات كلها. بدونه تُستخدم قيمة احتياطية غير صالحة للإطلاق.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── مفتاح HMAC لتوقيع رموز OTP وتجزئة حوامل الجلسة ───
# ★ إلزامي في الإنتاج (قيمة عشوائية فريدة):
#   openssl rand -hex 32
OTP_PEPPER="dev-only-pepper-change-me"

# ─── وضع المحاكاة: يطبع رمز OTP في سجل الخادم بدل إرسال SMS ───
# الإنتاج بدون مزوّد حقيقي يفشل بوعي (503) — لا تفعّل المحاكاة في الإطلاق.
OTP_MOCK="true"

# ═══════════════════════════════════════════════════════════════════
# ★ نقاط التكامل المطلوبة بعد الإطلاق (غير مفعّلة حالياً — دليل تركيب)
# التفاصيل الكاملة في README.md ← «نقاط التكامل المطلوبة بعد الإطلاق»
# ═══════════════════════════════════════════════════════════════════

# ─── مزوّد SMS لرموز OTP (نقطة التركيب: src/lib/auth/otp-sender.ts) ───
# SMS_PROVIDER="twilio"            # أو infobip / بوابة محلية
# SMS_API_KEY=""
# SMS_SENDER_ID="AqarMatch"

# ─── WhatsApp Business API (OTP + إشعارات الأطراف) ───
# نقاط التركيب: src/lib/auth/otp-sender.ts + طبقة خدمة المطابقات
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_OTP_TEMPLATE="aqar_otp"

# ─── بوابة الدفع الجزائرية (رسم البائع — نقطة التركيب: src/lib/matches/service.ts) ───
# PAYMENT_PROVIDER="satim"          # CIB / EDAHABIA عبر SATIM (أو baridimob / ccp_manual)
# PAYMENT_MERCHANT_ID=""
# PAYMENT_TERMINAL_ID=""
# PAYMENT_SECRET_KEY=""
# PAYMENT_WEBHOOK_SECRET=""        # توقيع webhooks التأكيد الواردة
# PAYMENT_RETURN_URL="https://aqar-match.example/payment/return"

# ─── الجدولة الدورية (cron خارجي أو Vercel Cron) ───
# النقاط الجاهزة للاستدعاء الدوري: POST /api/matches/expire + POST /api/uploads/sweep
# (تُحمى حالياً بجلسة admin — عند اعتماد خدمة داخلية أضف مفتاح خدمة هنا)
# CRON_SECRET=""
